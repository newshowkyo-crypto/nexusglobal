# NexusGlobal MAMR-System 环境配置
# 复制此文件为 .env 并填入真实值

# === 基础配置 ===
APP_ENV=local                           # local / staging / production
HTTP_ADDR=:8080                         # API 监听地址
POSTGRES_DSN=postgres://nexus:nexus@localhost:5432/nexus?sslmode=disable
REDIS_ADDR=localhost:6379

# === 外部依赖模式 ===
EXTERNAL_MODE=mock                      # mock / real（切换 LP/Bank/MAE 连接器）
KMS_MODE=mock                           # mock / real（切换加密后端）

# === 密钥（切生产必须改） ===
MASTER_KEY_BASE64=<BASE64_32BYTE_KEY_REQUIRED>   # mock 模式用；production 时 KMS_MODE=real
JWT_SECRET=<YOUR_JWT_SECRET_HERE>                # JWT 签名密钥（production 必填）
INTERNAL_TOKEN=<YOUR_INTERNAL_TOKEN_HERE>         # 内部 API 认证令牌（production 必填）
ADMIN_SESSION_SECRET=<YOUR_ADMIN_SESSION_SECRET>  # Admin 会话密钥（production 必填）

# === LP 连接器（EXTERNAL_MODE=real 时必填） ===
LP_BASE_URL=                            # LP API 基础 URL
LP_API_KEY=                             # LP API Key

# === Bank 连接器（EXTERNAL_MODE=real 时必填） ===
BANK_BASE_URL=                          # Bank API 基础 URL
BANK_API_KEY=                           # Bank API Key

# === MAE 连接器（EXTERNAL_MODE=real 时必填） ===
MAE_BASE_URL=                           # MAE API 基础 URL
MAE_API_KEY=                            # MAE API Key

# === Checkout 订单源 ===
CHECKOUT_ORDER_PROVIDER=mock            # mock / http / disabled
                                        # mock: 本地 Mock 订单源（仅 local/mock 环境使用）
                                        # http: 真实 HTTP 订单源（staging/production 使用）
                                        # disabled: 禁用订单功能
                                        # ⚠️ production 环境禁止使用 mock

# === 收单 Provider ===
ACQUIRER_PROVIDER=mock                  # mock / stripe / nxtapay / disabled
                                        # mock: 本地 Mock 收单（仅 local 环境使用）
                                        # stripe: Stripe 收单（sandbox/production 使用）
                                        # nxtapay: Nxtapay 收单（sandbox/production 使用）
                                        # ⚠️ production 环境禁止使用 mock

# === 发卡 Provider ===
ISSUING_PROVIDER=mock                   # mock / <real_provider> / disabled
                                        # mock: 本地 Mock 发卡（仅 local 环境使用）
                                        # ⚠️ production 环境禁止使用 mock

# === VCC Funding Provider ===
VCC_FUNDING_PROVIDER=mock               # mock / crypto_bridge / fiat_direct / disabled
                                        # mock: 本地 Mock 资金路由（仅 local 环境使用）
                                        # crypto_bridge: 加密桥资金路由
                                        # fiat_direct: 法币直接路由
                                        # ⚠️ production 环境禁止使用 mock

# === Vault KMS（KMS_MODE=real 时必填） ===
VAULT_BASE_URL=                         # HashiCorp Vault 地址
VAULT_TOKEN=                            # Vault Token
VAULT_MOUNT_PATH=transit                # Vault Transit 引擎挂载路径
VAULT_KEY_NAME=mamr-master              # Vault 密钥名称

# === Stripe Sandbox 凭证 ===
STRIPE_SANDBOX_SECRET=                  # Stripe Sandbox Secret Key
STRIPE_SANDBOX_WEBHOOK_SECRET=          # Stripe Sandbox Webhook Secret

# === Nxtapay Sandbox 凭证 ===
NXTAPAY_SANDBOX_API_KEY=                # Nxtapay Sandbox API Key
NXTAPAY_SANDBOX_API_SECRET=             # Nxtapay Sandbox API Secret
NXTAPAY_SANDBOX_MERCHANT_ID=            # Nxtapay Sandbox Merchant ID
NXTAPAY_SANDBOX_WEBHOOK_SECRET=         # Nxtapay Sandbox Webhook Secret

# === VCC Sandbox 凭证 ===
VCC_SANDBOX_PROVIDER=                   # VCC 发卡 Sandbox Provider 名称
VCC_SANDBOX_API_KEY=                    # VCC Sandbox API Key
VCC_SANDBOX_WEBHOOK_SECRET=             # VCC Sandbox Webhook Secret

# === Worker 配置 ===
OUTBOX_WORKER_CONCURRENCY=4
OUTBOX_CLAIM_BATCH=16
STREAM_MAX_DELIVERIES=5
SWEEP_TICK_INTERVAL=10s
LOG_LEVEL=info

# === Production 门禁配置 ===
# 以下配置在 APP_ENV=production 时必须填写
DB_MIGRATION_MODE=auto                  # auto / manual（production 建议 manual）
REQUIRE_VAULT=true                      # 是否要求 Vault（production 必须 true）
REQUIRE_WEBHOOK_SECRET=true             # 是否要求 Webhook Secret（production 必须 true）
REQUIRE_ADMIN_AUTH=true                 # 是否要求 Admin 认证（production 必须 true）
