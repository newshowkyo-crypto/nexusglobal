{
  "name": "NexusGlobal Checkout",
  "version": "1.0.0",
  "description": "Hosted checkout page for NexusGlobal payment processing",
  "author": "NexusGlobal",
  "license": "proprietary",
  "checkout": {
    "name": "NexusGlobal Checkout",
    "description": "Secure hosted checkout page for processing payments",
    "icon": "https://nexusglobal.com/icon.png",
    "logo": "https://nexusglobal.com/logo.png",
    "brand_color": "#4f46e5",
    "locale": "en-US",
    "currency": "USD",
    "supported_payment_methods": [
      "card"
    ],
    "features": {
      "3d_secure": true,
      "tokenization": true,
      "webhooks": true,
      " refunds": true
    },
    "urls": {
      "checkout": "/checkout",
      "success": "/checkout/success",
      "cancel": "/checkout/cancel",
      "webhook": "/webhook/checkout"
    },
    "settings": {
      "session_timeout_minutes": 15,
      "max_retry_attempts": 3,
      "collect_billing_address": false,
      "collect_shipping_address": false,
      "allow_coupon_codes": false
    },
    "appearance": {
      "theme": "light",
      "font_family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif",
      "border_radius": "8px",
      "button_style": "filled"
    }
  },
  "api": {
    "version": "2024-01-01",
    "endpoints": {
      "create_session": {
        "method": "POST",
        "path": "/api/checkout/sessions",
        "description": "Create a new checkout session",
        "parameters": {
          "order_id": {
            "type": "string",
            "required": true,
            "description": "Unique order identifier"
          },
          "amount": {
            "type": "integer",
            "required": true,
            "description": "Amount in smallest currency unit (e.g., cents)"
          },
          "currency": {
            "type": "string",
            "required": true,
            "description": "Three-letter ISO currency code"
          },
          "merchant_id": {
            "type": "string",
            "required": true,
            "description": "Merchant identifier"
          },
          "success_url": {
            "type": "string",
            "required": false,
            "description": "URL to redirect after successful payment"
          },
          "cancel_url": {
            "type": "string",
            "required": false,
            "description": "URL to redirect after cancelled payment"
          }
        },
        "response": {
          "checkout_url": {
            "type": "string",
            "description": "URL to redirect customer to checkout"
          },
          "session_id": {
            "type": "string",
            "description": "Checkout session identifier"
          }
        }
      },
      "validate_token": {
        "method": "GET",
        "path": "/api/checkout/validate",
        "description": "Validate checkout token and get order details",
        "parameters": {
          "token": {
            "type": "string",
            "required": true,
            "description": "Checkout token from URL"
          }
        },
        "response": {
          "order_id": {
            "type": "string",
            "description": "Order identifier"
          },
          "merchant_name": {
            "type": "string",
            "description": "Merchant display name"
          },
          "amount": {
            "type": "string",
            "description": "Formatted amount"
          },
          "currency": {
            "type": "string",
            "description": "Currency code"
          }
        }
      },
      "charge": {
        "method": "POST",
        "path": "/api/checkout/charge",
        "description": "Process payment",
        "parameters": {
          "token": {
            "type": "string",
            "required": true,
            "description": "Checkout token"
          },
          "card_number": {
            "type": "string",
            "required": true,
            "description": "Card number"
          },
          "card_expiry": {
            "type": "string",
            "required": true,
            "description": "Card expiry (MM/YY)"
          },
          "card_cvv": {
            "type": "string",
            "required": true,
            "description": "Card CVV"
          }
        },
        "response": {
          "success": {
            "type": "boolean",
            "description": "Whether payment was successful"
          },
          "transaction_id": {
            "type": "string",
            "description": "Transaction identifier"
          },
          "redirect_url": {
            "type": "string",
            "description": "URL to redirect after payment"
          }
        }
      }
    }
  },
  "webhooks": {
    "events": [
      "checkout.session.completed",
      "checkout.session.expired",
      "payment_intent.succeeded",
      "payment_intent.failed"
    ],
    "payload_example": {
      "event": "checkout.session.completed",
      "data": {
        "session_id": "sess_123",
        "order_id": "order_456",
        "merchant_id": "merch_789",
        "amount": 1000,
        "currency": "USD",
        "status": "completed",
        "created_at": "2024-01-01T00:00:00Z"
      }
    }
  }
}